{
  "global": { "ask_for_confirmation_before_quitting": true },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "devices": [],
      "simple_modifications": [
        { "from": { "key_code": "caps_lock" }, "to": [ { "key_code": "left_control" } ] }
      ],
      "complex_modifications": {
        "parameters": { "basic.simultaneous_threshold_milliseconds": 50 },
        "rules": [
          {
            "description": "Ctrl+Y → Redo (⌘+Shift+Z)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "y", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "z", "modifiers": ["left_command","left_shift"] } ]
              }
            ]
          },
          {
            "description": "Ctrl+[ → Escape",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "open_bracket", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "escape" } ]
              }
            ]
          },
          {
            "description": "Ctrl+Backspace → Option+Backspace (word delete)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "delete_or_backspace", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "delete_or_backspace", "modifiers": ["left_option"] } ]
              }
            ]
          },
          {
            "description": "Ctrl+Z → Undo (⌘+Z)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "z", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "z", "modifiers": ["left_command"] } ]
              }
            ]
          },
          {
            "description": "Windows-style Ctrl + C/X/V/A shortcuts",
            "manipulators": [
              { "type": "basic", "from": { "key_code": "c", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "c", "modifiers": ["left_command"] } ] },
              { "type": "basic", "from": { "key_code": "v", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "v", "modifiers": ["left_command"] } ] },
              { "type": "basic", "from": { "key_code": "x", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "x", "modifiers": ["left_command"] } ] },
              { "type": "basic", "from": { "key_code": "a", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "a", "modifiers": ["left_command"] } ] }
            ]
          },
          {
            "description": "Windows-style find shortcuts: Ctrl+F/G/Shift+G",
            "manipulators": [
              { "type": "basic", "from": { "key_code": "f", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "f", "modifiers": ["left_command"] } ] },
              { "type": "basic", "from": { "key_code": "g", "modifiers": { "mandatory": ["control"], "optional": ["any"] } }, "to": [ { "key_code": "g", "modifiers": ["left_command"] } ] },
              { "type": "basic", "from": { "key_code": "g", "modifiers": { "mandatory": ["control","left_shift"], "optional": ["any"] } }, "to": [ { "key_code": "g", "modifiers": ["left_command","left_shift"] } ] }
            ]
          }
        ]
      }
    }
  ]
}
JSON && \
pkill -f karabiner_grabber; pkill -f karabiner_observer; pkill -f Karabiner-Elements; open -a Karabiner-Elements


cd ±
# backup current config (if any)
cp -a ~/.config/karabiner/karabiner.json{,.bak.$(date +%s)} 2>/dev/null || true

# ensure config dir exists
mkdir -p ~/.config/karabiner

# write the full config
cat > ~/.config/karabiner/karabiner.json <<'JSON'
{
  "global": { "ask_for_confirmation_before_quitting": true },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "devices": [],
      "simple_modifications": [
        { "from": { "key_code": "caps_lock" }, "to": [ { "key_code": "left_control" } ] }
      ],
      "complex_modifications": {
        "parameters": { "basic.simultaneous_threshold_milliseconds": 50 },
        "rules": [
          {
            "description": "Ctrl+Y → Redo (Cmd+Shift+Z)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "y", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "z", "modifiers": ["left_command","left_shift"] } ]
              }
            ]
          },
          {
            "description": "Ctrl+[ → Escape",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "open_bracket", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "escape" } ]
              }
            ]
          },
          {
            "description": "Ctrl+Backspace → Option+Backspace (delete previous word)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "delete_or_backspace", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "delete_or_backspace", "modifiers": ["left_option"] } ]
              }
            ]
          },

          // 1) Ctrl+Z → Undo (Cmd+Z)
          {
            "description": "Ctrl+Z → Undo (Cmd+Z)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "z", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "z", "modifiers": ["left_command"] } ]
              }
            ]
          },

          // 2) Ctrl+C / V / X → Cmd+C / V / X
          {
            "description": "Ctrl+C/V/X → Cmd+C/V/X",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "c", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "c", "modifiers": ["left_command"] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "v", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "v", "modifiers": ["left_command"] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "x", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "x", "modifiers": ["left_command"] } ]
              }
            ]
          },

          // 3) Ctrl+A → Select All (Cmd+A)
          {
            "description": "Ctrl+A → Select All (Cmd+A)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "a", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "a", "modifiers": ["left_command"] } ]
              }
            ]
          },

          // 7) Ctrl+F/G/Shift+G → Cmd+F/G/Shift+G (Find / Next / Previous)
          {
            "description": "Ctrl+F/G/Shift+G → Cmd equivalents (Find / Next / Previous)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "f", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "f", "modifiers": ["left_command"] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "g", "modifiers": { "mandatory": ["control"], "optional": ["any"] } },
                "to": [ { "key_code": "g", "modifiers": ["left_command"] } ]
              },
              {
                "type": "basic",
                "from": { "key_code": "g", "modifiers": { "mandatory": ["control","shift"], "optional": ["any"] } },
                "to": [ { "key_code": "g", "modifiers": ["left_command","left_shift"] } ]
              }
            ]
          }
        ]
      }
    }
  ]
}
