#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: wt-done [feature-name]"
}

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

required_tools=(git tmux)
for tool in "${required_tools[@]}"; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "Missing required tool: $tool" >&2
    exit 1
  fi
done

feature_name="${1:-}"
repo_root=""
if [[ -z "$feature_name" ]]; then
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -z "$repo_root" ]]; then
    echo "Not inside a git repository and no feature name provided" >&2
    usage
    exit 1
  fi

  worktree_base=$(git rev-parse --git-path worktrees 2>/dev/null || true)
  if [[ -z "$worktree_base" ]]; then
    echo "Unable to resolve worktree metadata" >&2
    exit 1
  fi

  worktree_dir=$(cd "$worktree_base" && pwd -P)
  if [[ ! -d "$worktree_dir" ]]; then
    echo "Worktree metadata directory not found" >&2
    exit 1
  fi

  feature_name=$(basename "$repo_root")
else
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not inside a git repository" >&2
    exit 1
  }
fi

main_repo=$(git rev-parse --path-format=absolute --git-path ../ 2>/dev/null || true)
if [[ -z "$main_repo" ]]; then
  main_repo=$(dirname "$repo_root")
fi

worktree_path="$(dirname "$repo_root")/$feature_name"

if tmux has-session -t "$feature_name" 2>/dev/null; then
  tmux kill-session -t "$feature_name"
fi

if [[ -d "$worktree_path" ]]; then
  git worktree remove "$worktree_path"
fi

git worktree prune

if git show-ref --verify --quiet "refs/heads/$feature_name"; then
  if ! git branch -d "$feature_name"; then
    echo "Branch '$feature_name' is not fully merged; not deleting." >&2
    exit 1
  fi
fi
